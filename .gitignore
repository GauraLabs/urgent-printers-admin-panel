# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
qa-pipeline/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA pipeline (see ../pipeline/README.md): screenshots/traces/video/audio are build products.
# Keep reusable plans, narration definitions and shot lists in Git. Existing tracked
# reports remain available; new capture logs and local recovery data stay on disk.
qa-pipeline/artifacts/screenshots
qa-pipeline/artifacts/traces
qa-pipeline/artifacts/video
qa-pipeline/artifacts/narration/**/*.mp3
qa-pipeline/playwright/fixtures/oversized*
qa-pipeline/artifacts/docs/**/*.pdf
playwright-report
test-results

# Local Python caches from tutorial utilities
__pycache__/
*.py[cod]

# Per-recording evidence, source snapshots and local recovery copies
/qa-pipeline/artifacts/runs/
/qa-pipeline/tutorials/**/frontend-reference/
/qa-pipeline/tutorials/**/backend-reference/
/qa-pipeline/tutorials/**/history/
/qa-pipeline/tutorials/**/assets/recovered/
/qa-pipeline/tutorials/**/assets/recovered-manifest.json
