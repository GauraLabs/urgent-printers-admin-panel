{
  "lines": [
    {
      "step_id": "intro",
      "text": "Delivered order से review आना, moderation, reply और public visibility जाँचना सीखिए।"
    },
    {
      "step_id": "cr-01",
      "text": "Customer account में delivered order खोलिए। उसी customer और product की eligible purchase से review देना चाहिए।"
    },
    {
      "step_id": "cr-02",
      "text": "Write a Review खोलिए। Pending delivery या दूसरे customer का order review के लिए eligible नहीं है।"
    },
    {
      "step_id": "cr-03",
      "text": "इस example में चार stars चुनिए। Rating customer के अपने अनुभव की होनी चाहिए।"
    },
    {
      "step_id": "cr-04",
      "text": "छोटा और स्पष्ट review title लिखिए।"
    },
    {
      "step_id": "cr-05",
      "text": "Print quality और अनुभव का feedback लिखिए। इस form में कम से कम बीस characters चाहिए।"
    },
    {
      "step_id": "cr-06",
      "text": "Submit Review दबाइए। Thank You और awaiting approval message जाँचिए; अभी यह public नहीं हुआ।"
    },
    {
      "step_id": "cr-07",
      "text": "Admin में Customers menu का Reviews खोलिए। यह product reviews हैं, homepage Testimonials से अलग।"
    },
    {
      "step_id": "cr-08",
      "text": "Status में Pending चुनिए। सही customer, product और linked order पहचानें।"
    },
    {
      "step_id": "cr-09",
      "text": "Stars और review text पढ़िए। केवल कम rating होने के कारण genuine feedback reject न करें।"
    },
    {
      "step_id": "cr-10",
      "text": "Review का order number खोलकर customer और delivered status confirm करें।"
    },
    {
      "step_id": "cr-11",
      "text": "Product page के Reviews tab में pending feedback public नहीं दिखना चाहिए।"
    },
    {
      "step_id": "cr-12",
      "text": "Moderate Reviews permission वाले staff सही row का green approve icon दबाएँ।"
    },
    {
      "step_id": "cr-13",
      "text": "Approved filter में वही review और status जाँचिए।"
    },
    {
      "step_id": "cr-14",
      "text": "Storefront reload करके Customer Reviews में title, feedback, stars और Verified Purchase देखें।"
    },
    {
      "step_id": "cr-15",
      "text": "Admin में message icon से Reply to Review खोलिए। Reply देने से rating नहीं बदलती।"
    },
    {
      "step_id": "cr-16",
      "text": "Customer को छोटा और विनम्र official response लिखिए। Private order या payment details public reply में न डालें।"
    },
    {
      "step_id": "cr-17",
      "text": "Post Reply दबाइए। Replied column में Yes जाँचिए।"
    },
    {
      "step_id": "cr-18",
      "text": "Reply dialog फिर खोलकर saved text confirm करें। इस version के storefront पर store reply अभी display नहीं होता।"
    },
    {
      "step_id": "cr-19",
      "text": "जरूरत हो तो उसी dialog में response सुधारिए। Customer के original feedback को admin यहाँ edit नहीं करता।"
    },
    {
      "step_id": "cr-20",
      "text": "Post Reply फिर दबाकर corrected response save करें और दोबारा खोलकर verify करें।"
    },
    {
      "step_id": "cr-21",
      "text": "इस training example में red Reject icon दिखाएँगे। असली review केवल policy के अनुसार reject करें; rating के कारण नहीं। यह delete नहीं है।"
    },
    {
      "step_id": "cr-22",
      "text": "Rejected filter में वही review जाँचिए। Record और saved reply अभी भी मौजूद हैं।"
    },
    {
      "step_id": "cr-23",
      "text": "Storefront refresh करके rejected feedback public list से हटना confirm करें।"
    },
    {
      "step_id": "cr-24",
      "text": "Decision बदलने पर उसी rejected row को approve करें। Public view में review वापस जाँचिए।"
    },
    {
      "step_id": "cr-25",
      "text": "इस version में customer review edit या delete करने के buttons नहीं हैं। Admin के पास approve, reject और reply controls हैं।"
    },
    {
      "step_id": "outro",
      "text": "हर change के बाद saved state और उसका actual असर जाँचिए। जरूरत हो तो इस lesson के chapter से step फिर देखिए।",
