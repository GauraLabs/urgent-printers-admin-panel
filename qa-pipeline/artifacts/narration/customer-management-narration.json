{
  "lines": [
    {
      "step_id": "intro",
      "text": "Customer ढूँढना, उसकी details समझना और जरूरत पर account ban या reinstate करना सीखिए।"
    },
    {
      "step_id": "cm-01",
      "text": "Customers menu में Customers खोलिए। Account customer website से बनता है; इस page पर नया account बनाने का control नहीं है।"
    },
    {
      "step_id": "cm-02",
      "text": "Customer, Status, Orders, Total Spent और Joined columns पढ़िए। सही customer पहचानने के बाद ही action लें।"
    },
    {
      "step_id": "cm-03",
      "text": "Search में customer का email लिखिए। मिलते-जुलते नामों में email से पहचान confirm करें।"
    },
    {
      "step_id": "cm-04",
      "text": "Status में Active चुनिए। Search और status filters साथ में लागू होते हैं।"
    },
    {
      "step_id": "cm-05",
      "text": "Customer के नाम पर click करके उसका profile खोलिए।"
    },
    {
      "step_id": "cm-06",
      "text": "Identity में नाम, email verification, phone और status जाँचिए। यह admin profile view है; यहाँ contact edit नहीं होता।"
    },
    {
      "step_id": "cm-07",
      "text": "Order Summary में orders और amounts देखें। Total Spent को settled collection न मानें; payment और refunds अलग जाँचें।"
    },
    {
      "step_id": "cm-08",
      "text": "Orders tab खोलिए। Status, amount और order date से customer की enquiry समझें।"
    },
    {
      "step_id": "cm-09",
      "text": "संबंधित order number खोलिए। आगे का action उसी order के actual status के अनुसार करें।"
    },
    {
      "step_id": "cm-10",
      "text": "Customer profile पर वापस आएँ। यह lesson customer management पर है; order fulfilment अलग lesson में है।"
    },
    {
      "step_id": "cm-11",
      "text": "Addresses tab में saved address और Default label देखें। यहाँ address edit करने का control नहीं है।"
    },
    {
      "step_id": "cm-12",
      "text": "Activity में orders और reviews की available history देखें। यह हर login और profile change की पूरी audit list नहीं है।"
    },
    {
      "step_id": "cm-13",
      "text": "Send Email एक mail-app shortcut है। Email address और message अलग से जाँचें; यहाँ से automatic message भेजने का दावा न करें।"
    },
    {
      "step_id": "cm-14",
      "text": "Ban Customer के लिए सही permission और उचित कारण जरूरी है। सही account की confirmation खोलिए।"
    },
    {
      "step_id": "cm-15",
      "text": "Ban sign-in रोकता है, पुराने orders cancel नहीं करता। Confirmation में email लिखा है, पर automatic email अभी नहीं भेजता।"
    },
    {
      "step_id": "cm-16",
      "text": "Ban Customer confirm करें। Profile में Banned status verify करें।"
    },
    {
      "step_id": "cm-17",
      "text": "Customers list में Banned filter से वही account खोजिए। History अभी भी मौजूद है।"
    },
    {
      "step_id": "cm-18",
      "text": "Customer sign-in असफल दिखना जाँचिए। UI generic error दिखाता है; Banned स्थिति admin में confirm करें।"
    },
    {
      "step_id": "cm-19",
      "text": "Admin में उसी customer का profile खोलिए। Reinstate करने से पहले account identity फिर confirm करें।"
    },
    {
      "step_id": "cm-20",
      "text": "Reinstate Customer दबाइए। इससे account access वापस मिलेगा।"
    },
    {
      "step_id": "cm-21",
      "text": "Reinstate confirm करें और Active status जाँचिए।"
    },
    {
      "step_id": "cm-22",
      "text": "Customer website पर sign-in फिर सफल होना confirm करें। यह password reset नहीं करता।"
    },
    {
      "step_id": "cm-23",
      "text": "Admin page reload करके Active status जाँचिए। केवल toast देखकर action पूरा न मानें।"
    },
    {
      "step_id": "cm-24",
      "text": "Customers list में search और status साफ करें। Existing orders और account history को अलग-अलग संभालें।"
    },
    {
      "step_id": "outro",
      "text": "हर change के बाद saved state और उसका actual असर जाँचिए। जरूरत हो तो इस lesson के chapter से step फिर देखिए।",
