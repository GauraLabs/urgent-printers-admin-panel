    {
      "step_id": "sn-03",
      "text": "Staff row पहचानिए। सही व्यक्ति के In-App, Email, SMS, WhatsApp और Push columns देखें।"
    },
    {
      "step_id": "sn-04",
      "text": "In-App चालू करें। हर toggle तुरंत save होता है; अलग Save button नहीं है।"
    },
    {
      "step_id": "sn-05",
      "text": "Email चालू करें। चुने हुए event के email alerts इस member को मिलेंगे।"
    },
    {
      "step_id": "sn-06",
      "text": "Phone नहीं होने पर SMS और WhatsApp disabled हैं। पहले Staff में सही phone जोड़िए।"
    },
    {
      "step_id": "sn-07",
      "text": "Phone वाले member की SMS preference चालू करें। Number और delivery service दोनों सही होने चाहिए।"
    },
    {
      "step_id": "sn-08",
      "text": "WhatsApp toggle अलग से चालू करें। यह Email या SMS को अपने आप नहीं बदलता।"
    },
    {
      "step_id": "sn-09",
      "text": "Push के लिए device permission और registered device भी जरूरी है। Toggle अकेले delivery की guarantee नहीं है।"
    },
    {
      "step_id": "sn-10",
      "text": "Order Status Changed tab खोलिए। New Order की choices यहाँ अपने आप copy नहीं होतीं।"
    },
    {
      "step_id": "sn-11",
      "text": "इस event के लिए In-App चालू करें। केवल जरूरी milestones की alerts रखें।"
    },
    {
      "step_id": "sn-12",
      "text": "Order Status Changed के लिए Email चालू करें।"
    },
    {
      "step_id": "sn-13",
      "text": "Page reload करके दोनों events की saved settings जाँचिए।"
    },
    {
      "step_id": "sn-14",
      "text": "New Order Placed में Email बंद करें। यह member का account या दूसरे channels बंद नहीं करता।"
    },
    {
      "step_id": "sn-15",
      "text": "Reload के बाद Email off और In-App on confirm करें। जरूरत बदलने पर इन्हीं controls से restore करें।"
    },
    {
      "step_id": "outro",
      "text": "हर change के बाद saved state और उसका actual असर जाँचिए। जरूरत हो तो इस lesson के chapter से step फिर देखिए।"
    }
